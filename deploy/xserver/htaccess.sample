# Xserver などの Apache で「限定公開」するための設定の見本。
# 使い方は README の「Xserver で限定公開する」を見てください。
# このファイルを .htaccess という名前にして、dist の中身と同じフォルダに置きます。

# ── パスワードをかける(Basic 認証) ──
# AuthUserFile には .htpasswd の「サーバー上の絶対パス」を書きます。
# Xserver のサーバーパネル「アクセス制限」で設定すると、この4行と .htpasswd は自動で作られます。
# その場合は、この4行を消して、下の部分だけを追記してください。
AuthType Basic
AuthName "Members only"
AuthUserFile /home/サーバーID/ドメイン名/htpasswd/.htpasswd
Require valid-user

# ── 検索エンジンに のせない ──
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# ── 読みこみを速くする ──
# assets の中のファイルは名前に中身の印(ハッシュ)が入っているので、長く覚えさせてよい。
# index.html は、更新がすぐ届くよう 覚えさせない。
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.mp3$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
